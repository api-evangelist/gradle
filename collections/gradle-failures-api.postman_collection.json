  "item": [
    {
      "id": "5a8f97ad-f00d-46d9-bfa2-358e0abe7db2",
      "name": "Failures",
      "description": {
        "content": "Endpoints related to retrieving details about failures of builds from the Develocity instance. \nTo access these endpoints the user requires the `Access build data via the API` permission.\n\n**<mark>Beta:</mark> _The Failures API is unstable and is likely to change in future._**\n",
        "type": "text/plain"
      },
      "item": [
