          "name": "Get the failures of a build.",
          "request": {
            "name": "Get the failures of a build.",
            "description": {
              "content": "**<mark>Beta:</mark>** Returns the failures of a build, organized by build tool (Gradle, Maven, npm).\nThe response structure includes nested objects for each build tool containing their respective failures.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "failures",
                "builds",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "availabilityWaitTimeoutSecs",
                  "value": "<integer>",
                  "description": "The query parameters used to retrieve the failures of a build."
                },
                {
                  "disabled": false,
                  "key": "maxFailures",
                  "value": "100",
                  "description": "The query parameters used to retrieve the failures of a build."
