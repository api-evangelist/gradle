                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/api/comparison/inputs?buildIdA=<string>&buildIdB=<string>&workUnitPath=<string>,<string>&cacheability=<string>&className=<string>&offset=0&limit=20",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "api",
                        "comparison",
                        "inputs"
                      ],
                      "query": [
