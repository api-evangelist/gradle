{
  "opencollection": "1.0.0",
  "info": {
    "name": "Develocity Auth Meta API",
    "version": "2026.2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Meta",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Provides the version of Develocity.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://develocity.example.com/api/version"
          },
          "docs": "This endpoint can be accessed by any authenticated user."
        }
      ]
    }
  ],
  "bundled": true
}