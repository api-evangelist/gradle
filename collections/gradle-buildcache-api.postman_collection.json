                      "name": "Create or update a Build Cache Node",
                      "id": "fc473ab6-9e2b-4585-8652-24d2222522bb",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "PUT",
                        "header": [
